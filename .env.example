# === LLM — choose one provider ===

# Option A: Ollama (free, runs locally — recommended)
LLM_PROVIDER=ollama
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Option B: Anthropic (needs a paid API key)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# === Postgres (docker-compose maps container 5432 -> host 5433) ===
POSTGRES_PORT=5433
POSTGRES_PASSWORD=helpdesk
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5433/helpdesk
READONLY_DATABASE_URL=postgresql://helpdesk_ro:helpdesk_ro@localhost:5433/helpdesk

# === RAG ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.5

# === Guardrails ===
# LLM classifier adds a second check on top of the rule patterns.
# Set to false for faster responses with Ollama.
GUARD_LLM_CLASSIFIER=false
AUDIT_LOG_PATH=logs/audit.jsonl
